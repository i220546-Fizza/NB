# MongoDB connection string. The database name is fixed in code to
# "nb_classic_scents" (see config/db.js) so this app always uses its own
# database even if this URI points at a cluster shared with another project -
# any /dbname path segment here is ignored.
MONGO_URI=mongodb://127.0.0.1:27017/nb_classic_scents

# Secret used to sign JWTs — replace with a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret

# Server port
PORT=5000

# Comma-separated list of allowed frontend origins for CORS
CLIENT_ORIGIN=http://localhost:5173

# Default admin account created by the seed script
ADMIN_NAME=NB Admin
ADMIN_EMAIL=admin@nbclassicscents.com
ADMIN_PASSWORD=change_this_password
